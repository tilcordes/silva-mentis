# silva-mentis web root (Apache). The PHP entry points send the security headers themselves;
# the rules below only cover static files.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  # Revalidate scripts and styles on every load so an update never mixes old and new modules.
  <FilesMatch "\.(js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Notes database, setup token and session data. Never committed.
/data/*
!/data/.htaccess
!/data/README.md

# Local configuration (created as a copy of config/config.example.php).
/config/config.php

# Development tools downloaded into the project (PHP binary, fonts, browser profile).
/.dev/

# Temporary files written by the test suites.
/tests/.tmp/

# Docker Compose settings of an installation (created as a copy of .env.example).
/.env
